# Database (defaults to local SQLite file if unset)
DATABASE_URL=sqlite:///./codeguard.db

# JWT auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# Optional LLM explanation layer (OpenAI-compatible).
# Leave OPENAI_API_KEY empty to run with deterministic explanations only.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Safety limits
MAX_CODE_LENGTH_CHARS=50000
